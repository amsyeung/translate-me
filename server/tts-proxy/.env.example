# Copy to .env (never commit .env) and fill in.

# Azure portal → your Speech resource (Free F0) → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

# Extensions allowed to call the proxy, comma-separated.
# The store version, plus your unpacked dev build's ID from chrome://extensions if you want to test it.
ALLOWED_ORIGINS=chrome-extension://fkoepnkpnaebnedkdnljkcdchljfoadi

# Limits (defaults shown). Azure F0: 20 requests / 60 s and ~500,000 characters / month.
# MAX_CHARS=300
# PER_IP_PER_MINUTE=20
# PER_IP_PER_DAY=400
# PER_IP_CHARS_PER_DAY=2000
# AZURE_PER_MINUTE=18
# DAILY_CHAR_LIMIT=13000
# MONTHLY_CHAR_LIMIT=400000
# CACHE_MAX_MB=300
